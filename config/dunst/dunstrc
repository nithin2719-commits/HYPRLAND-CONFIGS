### Graphite notifications — dunst (Option 2: Top-Right Minimalist Arch Card)

[global]
    monitor = 0
    follow = mouse

    ### geometry ###########################################################
    width = (340, 420)
    height = (0, 260)
    origin = top-right
    offset = (16, 44)
    scale = 0
    notification_limit = 4
    layer = overlay

frame_width = 2
corner_radius = 15
gap_size = 10

markup = full

# 🔥 smooth volume animation bar
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 0
progress_bar_corner_radius = 6

transparency = 10

[urgency_low]
timeout = 1
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_normal]
timeout = 1
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_critical]
timeout = 2
background = "#1e1e2ecc"
foreground = "#f38ba8"
frame_color = "#f38ba8"
