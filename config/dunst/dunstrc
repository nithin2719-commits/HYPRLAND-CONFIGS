### Graphite notifications — dunst (Option 2: Top-Right Minimalist Arch Card)

[global]
    monitor = 0
    follow = mouse

    ### geometry ###########################################################
    width = (340, 420)
    height = (0, 260)
    origin = top-right
    offset = (16, 44)
    scale = 0
    notification_limit = 4
    layer = overlay

    ### the surface ########################################################
    frame_width = 1
    frame_color = "#3a3a42"
    corner_radius = 14
    corners = all
    gap_size = 10
    separator_height = 0
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 16
    transparency = 0

    ### text ###############################################################
    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<span size='small' foreground='#8a8a95'>%a</span>\n<span size='large' foreground='#f2f2f5'><b>%s</b></span>\n<span foreground='#9b9ba4'>%b</span>"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    word_wrap = yes
    ignore_newline = no
    show_age_threshold = 60
    hide_duplicate_count = false
    stack_duplicates = true
    show_indicators = false

    ### icons ##############################################################
    enable_recursive_icon_lookup = true
    icon_theme = "Obsidian, Adwaita, hicolor"
    icon_position = left
    default_icon = ~/.config/dunst/mark.png
    min_icon_size = 48
    max_icon_size = 64

transparency = 10

[urgency_low]
timeout = 1
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_normal]
timeout = 1
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_critical]
timeout = 2
background = "#1e1e2ecc"
foreground = "#f38ba8"
frame_color = "#f38ba8"
