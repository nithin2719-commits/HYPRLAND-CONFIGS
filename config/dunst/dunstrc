### Graphite notifications — dunst (Option 2: Top-Right Minimalist Arch Card)

[global]
    monitor = 0
    follow = mouse

    ### geometry ###########################################################
    width = (340, 420)
    height = (0, 260)
    origin = top-right
    offset = (16, 44)
    scale = 0
    notification_limit = 4
    layer = overlay

    ### the surface ########################################################
    frame_width = 1
    frame_color = "#3a3a42"
    corner_radius = 14
    corners = all
    gap_size = 10
    separator_height = 0
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 16
    transparency = 0

markup = full

# 🔥 smooth volume animation bar
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 0
progress_bar_corner_radius = 6

transparency = 10

[urgency_low]
timeout = 1
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_normal]
timeout = 1
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_critical]
timeout = 2
background = "#1e1e2ecc"
foreground = "#f38ba8"
frame_color = "#f38ba8"
