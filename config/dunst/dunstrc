### Graphite notifications — dunst (Option 2: Top-Right Minimalist Arch Card)

[global]
    monitor = 0
    follow = mouse

    ### geometry ###########################################################
    width = (340, 420)
    height = (0, 260)
    origin = top-right
    offset = (16, 44)
    scale = 0
    notification_limit = 4
    layer = overlay

    ### the surface ########################################################
    frame_width = 1
    frame_color = "#3a3a42"
    corner_radius = 14
    corners = all
    gap_size = 10
    separator_height = 0
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 16
    transparency = 0

    ### text ###############################################################
    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<span size='small' foreground='#8a8a95'>%a</span>\n<span size='large' foreground='#f2f2f5'><b>%s</b></span>\n<span foreground='#9b9ba4'>%b</span>"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    word_wrap = yes
    ignore_newline = no
    show_age_threshold = 60
    hide_duplicate_count = false
    stack_duplicates = true
    show_indicators = false

    ### icons ##############################################################
    enable_recursive_icon_lookup = true
    icon_theme = "Obsidian, Adwaita, hicolor"
    icon_position = left
    default_icon = ~/.config/dunst/mark.png
    min_icon_size = 48
    max_icon_size = 64

    ### progress bar (volume/brightness) ###################################
    progress_bar = true
    progress_bar_height = 5
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 2
    progress_bar_min_width = 200
    progress_bar_max_width = 368
    highlight = "#b9b9c2"

    ### behaviour ##########################################################
    sort = urgency_descending
    idle_threshold = 120
    sticky_history = yes
    history_length = 40
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current
    dmenu = /usr/bin/rofi -dmenu -p notify -theme ~/.config/rofi/blackarch-theme.rasi
    browser = /usr/bin/xdg-open
    always_run_script = true
    ignore_dbusclose = false

[experimental]
    enable_pcre_regex = true

[urgency_low]
    timeout = 3
    default_icon = ~/.config/dunst/mark-dim.png
    background = "#121216cc"
    foreground = "#9b9ba4"
    frame_color = "#2a2a30"
    format = "<span size='small' foreground='#6e6e78'> %a</span>\n<span size='large' foreground='#f2f2f5'><b>%s</b></span>\n<span foreground='#8a8a93'>%b</span>"

[urgency_normal]
    timeout = 5
    background = "#121216d9"
    foreground = "#e6e6ea"
    frame_color = "#3a3a42"

[urgency_critical]
    timeout = 20
    default_icon = ~/.config/dunst/mark-hot.png
    background = "#16161ceb"
    foreground = "#f2f2f5"
    frame_color = "#9b9ba4"
    fullscreen = show
    format = "<span size='small' foreground='#9b9ba4'> %a  ·  urgent</span>\n<span size='large' foreground='#f2f2f5'><b>%s</b></span>\n<span foreground='#c8c8ce'>%b</span>"

[chat-whatsapp]
    summary = "(?i).*(whatsapp).*"
    appname = "(?i).*(whatsapp|zapzap|chrome|google-chrome|chromium|brave).*"
    default_icon = /usr/share/icons/Papirus/64x64/apps/whatsapp.svg
    new_icon = /usr/share/icons/Papirus/64x64/apps/whatsapp.svg
    icon = /usr/share/icons/Papirus/64x64/apps/whatsapp.svg
    timeout = 8
    urgency = normal
    fullscreen = show

[mail-gmail]
    summary = "(?i).*(gmail|mail\.google).*"
    appname = "(?i).*(gmail|mail\.google|chrome|google-chrome|chromium|brave).*"
    default_icon = /usr/share/icons/Papirus/64x64/apps/gmail.svg
    new_icon = /usr/share/icons/Papirus/64x64/apps/gmail.svg
    icon = /usr/share/icons/Papirus/64x64/apps/gmail.svg
    timeout = 8
    urgency = normal
    fullscreen = show

[chat-telegram]
    appname = "(?i)telegram"
    default_icon = telegram
    new_icon = telegram

[chat-discord]
    appname = "(?i)discord"
    default_icon = discord
    new_icon = discord

[chat-apps]
    appname = "(?i)(signal|element|slack)"
    timeout = 7
    urgency = normal
    frame_color = "#5c5c66"
    fullscreen = show
    format = "<span size='small' foreground='#8a8a95'>󰭹  %a</span>\n<span size='large' foreground='#f2f2f5'><b>%s</b></span>\n<span foreground='#b0b0b8'>%b</span>"

[browser-web-notifications]
    appname = "(?i)(chromium|google.?chrome|chrome)"
    timeout = 6
    fullscreen = show
    format = "<span size='small' foreground='#8a8a95'>󰖟  %a</span>\n<span size='large' foreground='#f2f2f5'><b>%s</b></span>\n<span foreground='#9b9ba4'>%b</span>"

[osd-transient]
    appname = volume
    timeout = 1
    urgency = low
    format = "<span size='large' foreground='#f2f2f5'><b>%s</b></span>"
    default_icon = ~/.config/dunst/mark.png
    set_stack_tag = osd
    history_ignore = yes

[osd-brightness]
    appname = brightness
    timeout = 1
    urgency = low
    format = "<span size='large' foreground='#f2f2f5'><b>%s</b></span>"
    default_icon = ~/.config/dunst/mark.png
    set_stack_tag = osd
    history_ignore = yes

[blackarch-toolbox]
    summary = "(?i)^blackarch"
    timeout = 2
    urgency = low
    format = "<span foreground='#9b9ba4'>󰣇  <span size='large' foreground='#f2f2f5'><b>%s</b></span>  %b</span>"
    history_ignore = yes

[screenshot-preview]
    appname = "(?i)(grim|grimblast|hyprshot|flameshot|swappy)"
    timeout = 6
    max_icon_size = 120
    format = "<span size='small' foreground='#6e6e78'> 󰄀  %a</span>\n<span size='large' foreground='#f2f2f5'><b>%s</b></span>\n<span foreground='#9b9ba4'>%b</span>"

# --- app icons -------------------------------------------------------------
# Matched on the exact app name the sender uses: this dunst matches filters
# literally, so the (?i).*(...).*  patterns below never fire. Everything that
# is not named here keeps the default Arch mark.
