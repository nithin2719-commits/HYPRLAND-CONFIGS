    // Notification indicator, matched to ~/.config/dunst/dunstrc.
    //
    // HyDE's own notifications.py is replaced by notif-graphite.py: the shipped
    // one bakes white/yellow/red pango spans into its icons, which clashes with
    // the graphite cards. The replacement emits the glyph itself plus a state
    // class (idle/history/waiting/paused) that style.css colours, so the bar
    // and the notifications stay one system.
    //
    // "escape" MUST stay false: the script emits pango markup (the <sup> count)
    // and escaping would print the tag literally.
    "custom/notifications": {
        "format": "{}",
        "rotate": ${r_deg},
        "return-type": "json",
        "exec-if": "which dunstctl",
        "exec": "notif-graphite.py",
        "on-scroll-down": "sleep 0.1 && dunstctl history-pop",
        "on-click": "dunstctl set-paused toggle",
        "on-click-middle": "dunstctl history-clear",
        "on-click-right": "dunstctl close-all",
        "interval": 2,
        "tooltip": true,
        "escape": false
    },
