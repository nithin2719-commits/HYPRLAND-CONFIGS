/* BlackArch Toolbox — rofi theme (v2, refined)
 *
 * Red-on-near-black identity, but everything is given room to breathe: a taller
 * brand bar, generous row padding, a clear active-row treatment (brighter fill,
 * a solid accent bar, bright text), and a hairline inner structure so the menu
 * reads as one deliberate surface instead of a cramped list. Neutrals are warmed
 * toward the accent so nothing looks like flat GTK grey.
 */

* {
    blood:       #ff2b2b;   /* primary accent — border, active bar, counts   */
    blood-soft:  #c81f22;
    ember:       #ff7a45;   /* secondary — highlights, keys                  */
    bg:          #0b0708;   /* window base                                   */
    bg-inputs:   #17090a;   /* brand / input bar                             */
    bg-alt:      #100a0b;   /* message strip, scrollbar trough               */
    row-sel:     #2a0b0e;   /* active row fill                               */
    fg:          #f4ecec;   /* bright body                                   */
    fg-dim:      #b09a9a;   /* tool descriptions / package names             */
    fg-faint:    #6a5555;   /* counts, hints                                 */
    transparent: rgba(0,0,0,0);

    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    background-color: @bg;
    /* Bold red frame. rofi can't animate/glow a border, so this is a vivid,
       slightly thick solid frame with soft corners for a framed, premium look. */
    border:           3px;
    border-color:     #ff3b3b;
    border-radius:    16px;
    width:            560px;   /* compact, as before */
    padding:          0px;

    /* Flush to the top-left corner, just under the waybar. */
    location:         north west;
    anchor:           north west;
    x-offset:         10px;
    y-offset:         8px;
}

mainbox {
    children: [ "inputbar", "message", "listview" ];
    spacing:  0px;
    padding:  0px;
}

inputbar {
    background-color:    #1a0000;
    border-radius:       8px 8px 0px 0px;
    border:              0px 0px 1px 0px;
    border-color:        @border;
    padding:             8px 12px;
    children:            [ "prompt", "entry" ];
}

prompt {
    background-color:    transparent;
    text-color:          @fg;
    padding:             0px 8px 0px 0px;
}

entry {
    background-color:    transparent;
    text-color:          @fg-alt;
    placeholder:         "search...";
    placeholder-color:   @fg-dim;
}

message {
    background-color:    #0a0000;
    border:              0px 0px 1px 0px;
    border-color:        #220000;
    padding:             4px 12px;
}

textbox {
    background-color:    transparent;
    text-color:          #ff4400;
    font:                "JetBrainsMono Nerd Font 9";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    spacing:             2px;
    padding:             6px;
    scrollbar:           false;
    fixed-height:        false;
}

element {
    background-color:    transparent;
    border-radius:       4px;
    padding:             7px 12px;
    cursor:              pointer;
    spacing:             8px;
}

element normal.normal {
    background-color:    transparent;
    text-color:          @fg-alt;
}

element alternate.normal {
    background-color:    #0a0000;
    text-color:          @fg-alt;
}

element selected.normal {
    background-color:    @select-bg;
    text-color:          @select-fg;
    border:              1px;
    border-color:        @border;
}

element-icon {
    size:                20px;
    background-color:    transparent;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    vertical-align:      0.5;
}
