{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "blackarch",
    "color": {
      "1": "bright_white",
      "2": "bright_white",
      "3": "bright_white",
      "4": "bright_white"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "brightColor": true,
    "color": {
      "keys": "bright_white",
      "title": "bright_white",
      "separator": "bright_white",
      "output": "bright_white"
    }
  },
  "modules": [
    "break",
    "break",
    "break",
    "break",
    "break",
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "system",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{pacman} pacman"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{used} / {total}"
    },
    {
      // {name:19}, not {name}. The full string is "Geforce RTX 3070 Ti Laptop
      // GPU" -- 30 chars, which made this the longest line in the block at 79
      // columns. The logo is 38 wide plus 6 of padding, so anything under 80
      // columns wrapped the tail onto column 0 and the fragment "p GPU" landed
      // under the logo, breaking the alignment in any tiled terminal.
      //
      // Truncating to 19 keeps "Geforce RTX 3070 Ti" and drops the redundant
      // "Laptop GPU" suffix. The longest line is now the memory row at 28, so
      // the whole block fits in 72 columns.
      "type": "gpu",
      "key": "gpu",
      "format": "{name:19}",
      "hideType": "integrated"
    },
    {
      "type": "terminal",
      "key": "term"
    }
  ]
}