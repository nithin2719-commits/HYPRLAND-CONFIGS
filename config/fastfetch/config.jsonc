{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "blackarch",
    "color": {
      "1": "bright_white",
      "2": "bright_white",
      "3": "bright_white",
      "4": "bright_white"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "brightColor": true,
    "color": {
      "keys": "bright_white",
      "title": "bright_white",
      "separator": "bright_white",
      "output": "bright_white"
    }
  },
  "modules": [
    "break",
    "break",
    "break",
    "break",
    "break",
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "system",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{pacman} pacman"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{used} / {total}"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "format": "{name}",
      "hideType": "integrated"
    },
    {
      "type": "terminal",
      "key": "term"
    }
  ]
}
