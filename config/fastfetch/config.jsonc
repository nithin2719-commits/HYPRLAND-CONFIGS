{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "blackarch",
    "color": {
      "1": "bright_white",
      "2": "bright_white",
      "3": "bright_white",
      "4": "bright_white"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    "color": {
      "keys": "31",
      "title": "31",
      "separator": "31",
      "output": "31"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    { "type": "battery", "colorOutput": false },
    "locale"
  ]
}
