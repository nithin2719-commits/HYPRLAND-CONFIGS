# ── history / shell state ────────────────────────────────────────────────
.bash_history
.zsh_history
.python_history
.zcompdump*
.lesshst

# ── local backups made while tweaking the rice ───────────────────────────
*.bak
*.bak-*
*.bak2
*.broken
*.save
*.old
*.orig
*.rej
*~

# ── caches / generated / runtime ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.log
config/OpenRGB/logs/
config/**/cache/
config/hyde/state/
config/hypr/hyde/state/
.cache/

# ── machine-specific, regenerated by HyDE on first run ───────────────────
config/hypr/themes/colors.conf
config/hypr/wallbash/
userprefs.confhyprctl
